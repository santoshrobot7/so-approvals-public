{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "so-approvals",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "so-approvals",
      "database_id": "9895b625-d3ea-49d0-9d56-39fb849451dc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
